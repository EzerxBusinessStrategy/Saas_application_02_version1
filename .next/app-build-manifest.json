      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(auth)/reset-password/page.js"
    ],
    "/(app)/[workspace]/tasks/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(app)/[workspace]/tasks/page.js"
