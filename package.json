{
  "name": "tenant-operations",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backend:dev": "corepack pnpm --filter @saas-app/backend dev",
    "backend:build": "corepack pnpm --filter @saas-app/backend build",
    "backend:start": "corepack pnpm --filter @saas-app/backend start",
    "backend:start:production": "corepack pnpm --filter @saas-app/backend start:production",
    "backend:bootstrap-super-admin": "corepack pnpm --filter @saas-app/backend bootstrap-super-admin",
    "backend:lint": "corepack pnpm --filter @saas-app/backend lint",
    "backend:typecheck": "corepack pnpm --filter @saas-app/backend typecheck",
    "backend:test": "corepack pnpm --filter @saas-app/backend test",
    "backend:test:db": "corepack pnpm --filter @saas-app/backend test:db",
    "backend:test:api": "corepack pnpm --filter @saas-app/backend test:api",
    "backend:test:watch": "corepack pnpm --filter @saas-app/backend test:watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:tokens": "tsx scripts/check-design-tokens.ts",
    "check:routes": "tsx scripts/check-route-permissions.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^9.1.8",
    "@storybook/nextjs": "^9.1.8",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "storybook": "^9.1.8",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
