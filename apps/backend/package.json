{
  "name": "@saas-app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File dev.ps1",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/main.ts",
    "start:production": "node dist/main.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "bootstrap-super-admin": "tsx src/cli/bootstrap-super-admin.ts",
    "bootstrap-portal-super-admin": "tsx src/cli/bootstrap-portal-super-admin.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts test/unit test/api",
    "test:db": "vitest run --config vitest.config.ts test/integration",
    "test:watch": "vitest --config vitest.config.ts",
    "test:api": "vitest run --config vitest.config.ts test/api"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^8.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-socket.io": "11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/websockets": "11.0.0",
    "@supabase/supabase-js": "^2.111.0",
    "argon2": "0.44.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "supertest": "^7.1.4",
    "testcontainers": "^12.0.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
