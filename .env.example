NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_COMPANY_NAME=Acme Operations
NEXT_PUBLIC_DEFAULT_PRIMARY_COLOUR=#2563eb

# Backend foundation placeholders. Use real values only in local or deployment
# environment files; never commit secrets.
BACKEND_APP_NAME=SaaS App Backend
BACKEND_PORT=4000
BACKEND_LOG_LEVEL=info
BACKEND_API_BASE_PATH=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_PUBLIC_APP_URL=http://localhost:3000
BACKEND_REQUEST_BODY_LIMIT_BYTES=1048576
BACKEND_TRUST_PROXY=false

# Backend database. Use app_runtime credentials for BACKEND_DATABASE_URL and a
# migration/table-owner connection for BACKEND_DATABASE_MIGRATION_URL.
BACKEND_DATABASE_URL=
BACKEND_DATABASE_MIGRATION_URL=
BACKEND_DATABASE_POOL_MAX=5

BACKEND_SUPABASE_URL=
BACKEND_SUPABASE_ANON_KEY=
BACKEND_SUPABASE_ADMIN_KEY=
BACKEND_SUPABASE_JWT_ISSUER=
BACKEND_SUPABASE_JWT_AUDIENCE=authenticated
BACKEND_SUPABASE_JWKS_URL=
BACKEND_SUPABASE_JWKS_TIMEOUT_MS=1500

# Optional one-time non-interactive Super Admin bootstrap input. Provide all
# three only when intentionally creating the first persistent platform admin.
BACKEND_BOOTSTRAP_SUPER_ADMIN_FULL_NAME=
BACKEND_BOOTSTRAP_SUPER_ADMIN_EMAIL=
BACKEND_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
